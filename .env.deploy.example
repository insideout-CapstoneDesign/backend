# Public host handled by Caddy
APP_HOST=api.example.com

# Spring profile / runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
TZ=Asia/Seoul

# PostgreSQL
POSTGRES_DB=insideout_db
POSTGRES_USER=insideout_admin
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/insideout_db
SPRING_DATASOURCE_USERNAME=insideout_admin
SPRING_DATASOURCE_PASSWORD=change-me

# Elasticsearch
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
PLACE_SEARCH_BOOTSTRAP_ENABLED=true
PLACE_SEARCH_BOOTSTRAP_BATCH_SIZE=500
PLACE_SEARCH_BOOTSTRAP_LOCK_ID=91000001

# MinIO / S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-strong-minio-secret-key
S3_BUCKET=insideout-assets

# JWT / external APIs
SECURITY_JWT_SECRET=replace-with-long-random-secret
TMAP_API_KEY=
KAKAO_REST_API_KEY=

# AI service (same VM or external)
AI_SERVICE_URL=http://ai:8000
AI_API_KEY_HEADER=x-api-key
AI_API_KEY=replace-with-strong-ai-api-key
AI_SERVICE_TIMEOUT=120
