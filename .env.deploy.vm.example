# Final Azure VM env for the full Docker Compose stack

APP_HOST=api.example.com

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
TZ=Asia/Seoul

POSTGRES_DB=insideout_db
POSTGRES_USER=insideout_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/insideout_db
SPRING_DATASOURCE_USERNAME=insideout_admin
SPRING_DATASOURCE_PASSWORD=change-me

SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
PLACE_SEARCH_BOOTSTRAP_ENABLED=true
PLACE_SEARCH_BOOTSTRAP_BATCH_SIZE=500
PLACE_SEARCH_BOOTSTRAP_LOCK_ID=91000001

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=insideout-floorplan

SECURITY_JWT_SECRET=replace-with-long-random-secret
SECURITY_JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
SECURITY_JWT_REFRESH_TOKEN_EXPIRATION_MS=1209600000
TMAP_API_KEY=
KAKAO_REST_API_KEY=

# When AI is included in the same Compose stack
AI_SERVICE_URL=http://ai:8000
AI_API_KEY_HEADER=x-api-key
AI_API_KEY=change-me-ai-key
AI_SERVICE_TIMEOUT=120
