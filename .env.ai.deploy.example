# Final Azure VM env for the AI container

ENVIRONMENT=production
LOG_LEVEL=INFO
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
BACKEND_URL=http://app:8080

S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-strong-minio-secret-key
S3_BUCKET=insideout-floorplan
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

OCR_LANGUAGE=ko
OCR_GPU=false
OCR_MODEL_STORAGE_DIR=
OCR_DOWNLOAD_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=0.0
ICON_TEMPLATE_DIR=app/assets/icon_templates
ICON_TEMPLATE_MATCH_THRESHOLD=0.75
ICON_TEMPLATE_NMS_THRESHOLD=0.3
